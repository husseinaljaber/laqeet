SITE_NAME=لقيت
PUBLIC_URL=https://laqeet.example
ADMIN_TOKEN=change-me-to-a-long-secret
# Accounts (mobile app). SECRET_KEY signs login tokens: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Email for verification and password-reset codes (any SMTP: Gmail app password, Zoho, Brevo…)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# On hosts that block SMTP (free Render): Brevo API key instead of SMTP_* (free 300 emails/day).
BREVO_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=          # the bot's @name without @, so app users can get their alerts on Telegram too
# Phone notifications (app): Firebase service-account JSON on one line. Empty = notifications are only logged.
FCM_SERVICE_ACCOUNT=
ADMIN_CHAT_ID=
# CITY_CHANNELS={"دمشق": "@laqeet_damascus", "حلب": "@laqeet_aleppo", "*sy": "@laqeet_syria", "*tr": "@laqeet_turkey"}
ANTHROPIC_API_KEY=
LLM_DAILY_LIMIT=300
UPDATE_MINUTES=20

# ---- the mobile app: shared job links (/j/<id>) open the app directly
# Android: SHA-256 of the Play signing key (Play Console → Test and release → App integrity). Comma-separated if several.
# APP_SHA256=AB:CD:...
# iOS: Apple Developer Team ID (needs the app's Associated Domains set up in Xcode).
# APP_IOS_TEAM_ID=
# Google Play link, shown on shared job pages as «نزّل التطبيق» once the app is published.
# APP_PLAY_URL=https://play.google.com/store/apps/details?id=com.laqeet.app
